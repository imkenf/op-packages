#!/bin/sh /etc/rc.common

START=98
STOP=10

USE_PROCD=1
PROG=/usr/sbin/beardropper
CONF_FILE=/etc/config/beardropper

validate_beardropper_section() {
	uci_load_validate beardropper beardropper "$1" "$2" \
		'enabled:bool:0' \
		'defaultMode:string:follow' \
		'attemptCount:uinteger:10' \
		'attemptPeriod:string:12h' \
		'banLength:string:1w' \
		'logLevel:range(0,3):1'
}

beardropper_instance() {
	[ "$2" = 0 ] || {
		echo "validation failed"
		return 1
	}

	[ "$enabled" = "1" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG" -m "$defaultMode"
	procd_set_param pidfile /var/run/beardropper.pid
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	config_load beardropper
	config_foreach validate_beardropper_section beardropper beardropper_instance
}

service_triggers() {
	procd_add_reload_trigger "beardropper"
}

reload_service() {
	restart
}
