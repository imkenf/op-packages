#!/bin/sh /etc/rc.common
START=98
USE_PROCD=1

PROG=/usr/sbin/beardropper

start_service() {
	local enabled
	enabled=$(uci -q get beardropper.@beardropper[0].enabled)
	[ "x$enabled" = "x1" ] || return 0

	# 确保持久状态目录存在
	mkdir -p /etc/beardropper

	procd_open_instance
	procd_set_param command "$PROG" -m follow
	procd_set_param respawn 3000 1 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

stop_service() {
	: # procd handles process termination
}

service_triggers() {
	procd_add_reload_trigger beardropper
}
